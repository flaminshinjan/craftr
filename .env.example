# One file for the whole monorepo. Copy to .env and fill in.
# The api reads it directly; the web app reads it through apps/web/.env.local (symlink).

# Neon Postgres
DATABASE_URL=

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Anthropic: chat, product spec, block selection, firmware
ANTHROPIC_API_KEY=

# OpenAI: product renders and block art
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Comma-separated emails that become admins on first sign-in
ADMIN_EMAILS=

# Local wiring
NEXT_PUBLIC_API_URL=http://localhost:4747
WEB_ORIGIN=http://localhost:3737

# Keep sign-in on our own pages
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Dodo Payments: subscriptions and credit packs (https://app.dodopayments.com -> Developer)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Show the Billing page and credit balance in the web app (set to 1 once the api has Dodo keys)
NEXT_PUBLIC_BILLING=
