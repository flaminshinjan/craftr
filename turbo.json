{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["DATABASE_URL", "CLERK_SECRET_KEY", "ANTHROPIC_API_KEY", "OPENAI_API_KEY", "ADMIN_EMAILS", "WEB_ORIGIN", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_BILLING", "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", ".vercel/output/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "dev": { "cache": false, "persistent": true }
  }
}
